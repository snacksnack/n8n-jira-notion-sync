            {
              "id": "condition-has-transition",
              "leftValue": "={{ $json.transitionId }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
